<%- include('partials/header') %>
<div class="card form-card">
  <h1>Update order</h1>
  <p class="subtitle" style="margin-bottom:20px;">Edit the order details</p>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/orders/<%= order._id %>/update" method="POST">
    <div class="form-group">
      <label for="customerName">Customer name</label>
      <input type="text" id="customerName" name="customerName" value="<%= order.customerName %>" required>
    </div>

    <div class="form-group">
      <label for="productName">Product</label>
      <select id="productName" name="productName" required>
        <option value="">-- Select a product --</option>
        <% products.forEach(product => { %>
          <option value="<%= product.productName %>" <%= product.productName === order.productName ? 'selected' : '' %>><%= product.productName %> (<%= product.unitPrice.toLocaleString("vi-VN") %> VND)</option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="quantity">Quantity</label>
      <input type="number" id="quantity" name="quantity" value="<%= order.quantity %>" min="1" required>
    </div>

    <div class="form-group">
      <label for="orderDate">Order date</label>
      <input type="date" id="orderDate" name="orderDate" value="<%= new Date(order.orderDate).toISOString().slice(0, 10) %>" required>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary btn-block" type="submit">Save changes</button>
      <a class="btn btn-ghost btn-block" href="/orders">Cancel</a>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
