<%- include('partials/header') %>
<div class="card form-card">
  <h1>New order</h1>
  <p class="subtitle" style="margin-bottom:20px;">Fill in the details below</p>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/create-order" method="POST">
    <div class="form-group">
      <label for="customerName">Customer name</label>
      <input type="text" id="customerName" name="customerName" value="<%= currentUser.username %>" required>
    </div>

    <div class="form-group">
      <label for="productName">Product</label>
      <select id="productName" name="productName" required>
        <option value="">-- Select a product --</option>
        <% products.forEach(product => { %>
          <option value="<%= product.productName %>"><%= product.productName %> (<%= product.unitPrice.toLocaleString("vi-VN") %> VND)</option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="quantity">Quantity</label>
      <input type="number" id="quantity" name="quantity" min="1" placeholder="1" required>
    </div>

    <div class="form-group">
      <label for="orderDate">Order date</label>
      <input type="date" id="orderDate" name="orderDate" required>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary btn-block" type="submit">Create order</button>
      <a class="btn btn-ghost btn-block" href="/orders">Cancel</a>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
